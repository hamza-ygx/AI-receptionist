{
  "regions": [
    "arn1"
  ],
  "functions": {
    "api/chat.js": {
      "maxDuration": 60,
      "includeFiles": "api/_data.json"
    },
    "api/assist.js": {
      "maxDuration": 60,
      "includeFiles": "api/_data.json"
    },
    "api/quick.js": {
      "maxDuration": 30,
      "includeFiles": "api/_data.json"
    },
    "api/speech-token.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), camera=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' wss://*.stt.speech.microsoft.com https://*.stt.speech.microsoft.com; img-src 'self' data:; media-src 'self' blob:; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "cleanUrls": true
}
