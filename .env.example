# ---------------------------------------------------------------------------
# RKJH AI Receptionist — environment variables (placeholders only).
# In Azure these are Function App settings; secrets are Key Vault references:
#   @Microsoft.KeyVault(SecretUri=https://<kv>.vault.azure.net/secrets/<name>/)
# Locally: copy api/local.settings.example.json → api/local.settings.json.
# ---------------------------------------------------------------------------

# Which functions this app registers: voice | dash | all
APP_ROLE=all

# PostgreSQL (local docker-compose). In Azure: PG_ENTRA_AUTH=true + PGUSER=<managed identity name>, no password.
PGHOST=localhost
PGPORT=5432
PGDATABASE=rkjh
PGUSER=rkjh
PGPASSWORD=rkjh_local_only
PG_ENTRA_AUTH=false
PGSSL=false

# Vapi (EU region)
VAPI_BASE_URL=https://api.eu.vapi.ai
VAPI_API_KEY=<vapi-private-api-key>                     # secret
VAPI_SQUAD_ID=<from vapi/state.<env>.json after sync>
VAPI_WEBHOOK_AUTH_MODE=hmac                            # hmac | bearer
VAPI_WEBHOOK_SECRET=<same secret as the Vapi HMAC custom credential>   # secret
VAPI_HMAC_SIGNATURE_HEADER=x-signature
VAPI_HMAC_TIMESTAMP_HEADER=x-timestamp
VAPI_HMAC_MAX_SKEW_S=300
VAPI_LLM_MODEL=gpt-5.4-mini:swedencentral
VAPI_VOICE_SV=sv-SE-SofieNeural
VAPI_VOICE_EN=en-GB-SoniaNeural

# Used only by `npm run vapi:sync`
VOICE_API_BASE_URL=https://<func-voice>.azurewebsites.net   # or your dev tunnel URL
VAPI_WEBHOOK_CREDENTIAL_ID=<vapi custom-credential id (HMAC)>
VAPI_AZURE_OPENAI_CREDENTIAL_ID=<vapi azure-openai credential id>
VAPI_AZURE_SPEECH_CREDENTIAL_ID=<vapi azure speech credential id>
VAPI_FALLBACK_NUMBER=                                   # optional; NEVER the RKJH main number
BLOCKED_TRANSFER_NUMBERS=+4635175570

# Twilio (+46 number imported into Vapi)
TWILIO_NUMBER_E164=+4610xxxxxxx
TWILIO_ACCOUNT_SID=<ACxxxxxxxx>
TWILIO_API_KEY=<SKxxxxxxxx>                             # secret
TWILIO_API_SECRET=<twilio-api-secret>                   # secret
TRANSFER_CALLER_ID=                                     # optional caller ID shown to consultants on transfer

# Microsoft Graph (calendar). Prefer certificate; secret only for local dev.
GRAPH_TENANT_ID=<tenant-guid>
GRAPH_CLIENT_ID=<app-registration-client-id>
GRAPH_CLIENT_CERT_PEM=<PEM incl. private key, \n-escaped>   # secret
GRAPH_CLIENT_SECRET=                                    # secret (dev only)

# Teams Workflows webhook URLs (one app setting per ref used in config/staff.yaml + office.yaml)
TEAMS_FLOW_AUTH=entra                                   # entra | none
TEAMS_FLOW_AUDIENCE=https://service.flow.microsoft.com/
TEAMS_WEBHOOK_RECEPTION=<https://...logic.azure.com/... or ...powerplatform.com/...>   # secret

# Azure OpenAI embeddings (Sweden Central)
AZURE_OPENAI_ENDPOINT=https://<aoai-resource>.openai.azure.com
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=                                   # leave empty to use managed identity

# Knowledge base
KB_ROOT_URL=https://rkjh.se
KB_INLINE_MAX_TOKENS=6000

# Dashboard
DASHBOARD_BASE_URL=https://<swa-hostname>
ASSISTANT_NAME=ASSISTANT_NAME
RETENTION_DAYS=30
