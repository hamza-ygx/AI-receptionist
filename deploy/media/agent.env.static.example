# Copied to deploy/media/agent.env.static on the VM (non-secret settings). Secrets are added by bootstrap.sh.
LIVEKIT_AGENT_NAME=rkjh-receptionist
PGHOST=<psql-rkjh-ai-prod.postgres.database.azure.com>
PGPORT=5432
PGDATABASE=rkjh
PGUSER=<vm-name, e.g. vm-rkjh-ai-prod-media>
PG_ENTRA_AUTH=true
PGSSL=true
AZURE_SPEECH_REGION=swedencentral
VOICE_SV=sv-SE-SofieNeural
VOICE_EN=en-GB-SoniaNeural
AZURE_OPENAI_ENDPOINT=https://<oai-rkjh-ai-prod>.openai.azure.com
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2025-04-01-preview
LLM_REASONING_EFFORT=none
TRUNK_NUMBER_E164=+4610xxxxxxx
TWILIO_TERMINATION_URI=<name>.pstn.dublin.twilio.com
TWILIO_SIGNALLING_CIDRS=54.171.127.192/30,35.156.191.128/30
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=<from provision-sip>
TRANSFER_MODE=warm
TRANSFER_RINGING_TIMEOUT_S=25
FALLBACK_TRANSFER_NUMBER=
MAX_CALL_SECONDS=900
TEAMS_FLOW_AUTH=entra
TEAMS_WEBHOOK_REFS=TEAMS_WEBHOOK_RECEPTION
GRAPH_TENANT_ID=<tenant-guid>
GRAPH_CLIENT_ID=<app-client-id>
DASHBOARD_BASE_URL=https://<swa-hostname>
ASSISTANT_NAME=ASSISTANT_NAME
COST_STT_PER_MIN=
COST_TTS_PER_MILLION_CHARS=
COST_LLM_INPUT_PER_MILLION_TOKENS=
COST_LLM_OUTPUT_PER_MILLION_TOKENS=
COST_PHONE_PER_MIN=
